# Required: your Discord bot token (Railway variable)
BOT_TOKEN=your-bot-token-here

# Bot owner. Only this user ID can run the admin commands.
OWNER_ID=1526647973986046034

# Optional: put a server ID here and slash commands register instantly in that
# server. Leave empty to register globally (can take up to an hour to show up).
GUILD_ID=

# Optional persistent defaults (otherwise use the slash commands in Discord)
TICKET_CATEGORY_ID=
AUTOROLE_ID=

# Optional: channel where deleted promotion messages are logged
AUTOMOD_LOG_CHANNEL_ID=

# Optional: where the small JSON config file is stored
DATA_FILE=data/config.json
